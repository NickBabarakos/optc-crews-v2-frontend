# App routes που θέλουν καθάρισμα
/app/banners/
/app/shops/

# Φάκελοι που δεν θέλουμε τώρα
/hooks/
/styles/
/types/

# Services που θέλουν καθάρισμα (μένει μόνο το characters.ts)
/services/banners.ts
/services/shops.ts

# Utils που θέλουν καθάρισμα (μένουν τα cn, collection-analysis, getImageSource, string-manipulation, ui-styles-helper)
/utils/banner-info-data.ts
/utils/date-utils.ts
/utils/probability.ts
/utils/shops-filters.ts